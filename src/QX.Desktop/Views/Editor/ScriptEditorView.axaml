<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:c="using:Qx.Desktop.Controls"
             xmlns:vm="using:Qx.Presentation.Services.Workspace"
             x:Class="Qx.Desktop.Views.Editor.ScriptEditorView"
             x:DataType="vm:ScriptDocument">

  <Grid RowDefinitions="Auto,*">
    <c:NoticeBar Name="Fallback" Grid.Row="0" IsVisible="False" />
    <Panel Name="Editors" Grid.Row="1">
      <ae:TextEditor Name="Plain"
                     Classes="script"
                     IsVisible="False"
                     IsReadOnly="True"
                     ShowLineNumbers="True"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto" />
    </Panel>
  </Grid>

</UserControl>
